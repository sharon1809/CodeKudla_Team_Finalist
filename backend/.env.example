# ===================================================
# MedSynexa Backend — Production Environment Template
# Copy this file to .env and fill in the 4 items below!
# ===================================================

# 1. ⚡ Cerebras API Key (Sub-second LLM reasoning)
LLM_PROVIDER=cerebras
CEREBRAS_API_KEY=your_cerebras_api_key_here
CEREBRAS_MODEL=llama3.1-70b

# 2. 🧠 Google Gemini API Key (Free 768-dim embeddings & Vision OCR)
# Get key for free at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_EMBEDDING_MODEL=text-embedding-004
GEMINI_CHAT_MODEL=gemini-2.5-flash

# 3. 🗄️ MongoDB URI (Local or free MongoDB Atlas cluster)
MONGODB_URI=mongodb://localhost:27017/medsynexa_db

# 4. 🐘 PostgreSQL + pgvector URL (Local or free Supabase / Neon DB)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/medsynexa

# Server & Security Defaults (Leave as is for local testing)
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
JWT_ACCESS_SECRET=medsynexa_access_secret_2026
JWT_REFRESH_SECRET=medsynexa_refresh_secret_2026
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=20
