# =============================================
# MedSynexa Backend — Environment Configuration
# =============================================

# Server
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# MongoDB (metadata, users, chats)
MONGODB_URI=mongodb://localhost:27017/medsynexa_db

# PostgreSQL + pgvector (vector embeddings)
# Install PostgreSQL locally and run: CREATE EXTENSION IF NOT EXISTS vector;
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/medsynexa

# JWT
JWT_ACCESS_SECRET=medsynexa_access_secret_change_in_prod
JWT_REFRESH_SECRET=medsynexa_refresh_secret_change_in_prod
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ⚡ Cerebras AI — Ultra-Fast Wafer-Scale Engine Inference (Optional)
# If CEREBRAS_API_KEY is provided, MedSynexa uses Cerebras for sub-second LLM reasoning!
LLM_PROVIDER=cerebras
CEREBRAS_API_KEY=your_cerebras_api_key_here
CEREBRAS_MODEL=llama3.1-70b

# Gemini AI — Free Tier (embeddings + fallback LLM)
# Get free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_EMBEDDING_MODEL=text-embedding-004
GEMINI_CHAT_MODEL=gemini-2.5-flash

# Local file storage
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=20
